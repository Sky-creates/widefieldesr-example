# Copy to .env (gitignored) if you want to point at your own data instead of
# the bundled sample. Not required to run this example as-is -- the notebook
# defaults to loading data/sample_odmr.mat directly.

# Read-only experimental data tree.
WIDEFIELDESR_DATA_ROOT=./data

# Git-tracked analysis provenance (metadata.json: ROI / pixel / fit-init defs).
WIDEFIELDESR_ANALYSIS_ROOT=./analysis

# Regenerable outputs (per-pixel fit maps *.npz, exported plot PDFs). Gitignored.
WIDEFIELDESR_OUTPUT_ROOT=./outputs
